# SlotRecorder git repo = CODE ONLY. Everything big or machine-local stays out, so a colleague's
# `git pull` is a few KB and never touches their recordings, settings, APKs or bundled runtime.

# recordings / analysis output / logs
videos/
logs/
catalog/

# machine-local settings & flags (pack.py already skips these; git must too)
config.json
python_dir.txt
STOP
STOP_*

# bundled runtime & binaries — colleagues get these once via the bootstrap package, not via updates
python/
tools/
apk_cache/

# build artifacts
*.zip
__pycache__/
*.pyc
*.bak

# one-time bootstrap script, delivered with the zip (repo is public -> no token inside). Kept out of
# the repo so it stays the machine-local bootstrap, not a tracked file.
setup_git.bat
.update_token
